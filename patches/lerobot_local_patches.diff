+def _normalize_image_value(key: str, value) -> "torch.Tensor":
+    """本地定制（2026-09-21）：把数据集里 0-255 的 float 图像换算到 0-1。
+
+    为什么必须做：运行时观测管线（processor/env_processor.py）会执行 `img.float()/255.0`，
+    而策略的归一化统计量（dataset_stats）也是 0-1 尺度。若示范数据（从 LeRobotDataset
+    读出的是 0-255 float32）不换算，示范图像经归一化后会变成上千的饱和值，视觉编码器
+    学不到任何有效特征 —— 现象就是"无论训多久、无论人怎么接管，策略完全不会做任务"。
+    """
+    if not (isinstance(value, torch.Tensor) and "image" in key and value.numel() > 0):
+        return value
+    # ① LeRobotDataset 读图像给的是 uint8 0-255（实测）→ 转 float 并 /255，与运行时一致
+    if not value.is_floating_point():
+        return value.float() / 255.0
+    # ② 已是 0-255 的 float（某些数据集/格式）→ 同样换算
+    if float(value.max()) > 1.5:
+        return (value / 255.0).clamp(0.0, 1.0)
+    # ③ 已经是 0-1 → 原样返回（避免重复除）
+    return value
+
