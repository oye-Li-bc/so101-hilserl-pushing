+@dataclass
+class EpisodeStats:
+    """累计 actor 报上来的回合统计（供实时进度行使用）。"""
+
+    episodes: int = 0
+    successes: int = 0
+    zero_intervention_successes: int = 0
+    _rate_sum: float = 0.0
+    _rate_n: int = 0
+
+    def update(self, message: dict) -> None:
+        self.episodes += 1
+        reward, rate = message.get("Episodic reward"), message.get("Intervention rate")
+        if isinstance(reward, (int, float)) and float(reward) >= 1.0:
+            self.successes += 1
+            if isinstance(rate, (int, float)) and float(rate) == 0:
+                self.zero_intervention_successes += 1
+        if isinstance(rate, (int, float)):
+            self._rate_sum += float(rate)
+            self._rate_n += 1
+
+    @property
+    def avg_intervention_rate(self) -> float | None:
+        return self._rate_sum / self._rate_n if self._rate_n else None
+
+
+def format_progress_summary(
+    optimization_step: int,
+    online_steps: int,
+    online_size: int,
+    offline_size: int,
+    hz: float | None,
+    stats: EpisodeStats,
+    training_infos: dict | None = None,
+) -> str:
+    """本地定制（2026-09-21）：一行【实时进度】。
+
+    为什么：原来只有每 100 步一行 `Number of optimization step`，中间每步还刷一行
+    `Optimization frequency loop [Hz]`（噪音）→ 用户看不出"还要多久 / 学得怎么样"。
+    这行把 训练步+百分比、回放池大小、优化频率、预计剩余时间、回合/成功/★、平均干预比例、
+    以及算法侧的 loss 放在一起，每 ~10 秒打一次。
+    """
+    pct = f"{optimization_step / online_steps * 100:.1f}%" if online_steps else "?"
+    parts = [f"训练步 {optimization_step}/{online_steps} ({pct})",
+             f"在线池 {online_size} 帧",
+             f"离线池 {offline_size} 帧"]
+    parts.append(f"优化 {hz:.1f} Hz" if hz else "优化 —")
+    if hz and online_steps and optimization_step < online_steps:
+        parts.append(f"剩余约 {(online_steps - optimization_step) / hz / 60:.0f} 分钟")
+    parts.append(f"回合 {stats.episodes}（成功 {stats.successes}，★ {stats.zero_intervention_successes}）")
+    rate = stats.avg_intervention_rate
+    parts.append(f"平均干预 {rate * 100:.0f}%" if rate is not None else "平均干预 —")
+    if training_infos:
+        picked = [f"{k} {v:.3f}" for k, v in training_infos.items()
+                  if isinstance(v, (int, float))
+                  and any(t in k.lower() for t in ("loss", "temperature", "q_", "entropy"))][:2]
+        parts.extend(picked)
+    return "[LEARNER] 实时进度 | " + " | ".join(parts)
+
+
+def format_episode_progress_line(
+    optimization_step: int,
+    online_steps: int,
+    interaction_message: dict,
+) -> str:
+    """把每回合的进度拼成一行可判断「它有没有在变好」的日志。
+
+    本地定制（2026-09-21）：系统一直在算 ``Intervention rate``，但从未打印过 ——
+    于是「策略到底有没有进步」只能靠感觉。把【训练步数 + 交互步 + 回合奖励 + 干预比例】
+    放在同一行后，判据变客观：**干预比例下降**、并且出现**零干预的成功回合**。
+    """
+    rate = interaction_message.get("Intervention rate")
+    rate_txt = f"{rate * 100:.0f}%" if isinstance(rate, (int, float)) else "?"
+    pct = f"{optimization_step / online_steps * 100:.1f}%" if online_steps else "?"
+    reward = interaction_message.get("Episodic reward", "?")
+    line = (
+        f"[LEARNER] 回合结束 | 训练步 {optimization_step}/{online_steps} ({pct})"
+        f" | 交互步 {interaction_message.get('Interaction step', '?')}"
+        f" | 回合奖励 {reward} | 干预比例 {rate_txt}"
+    )
+    # 最有价值的一类回合：全程没接管（干预 0%）且成功 —— 这才是「策略自己会了」
+    if isinstance(rate, (int, float)) and rate == 0 and isinstance(reward, (int, float)) and float(reward) >= 1.0:
+        line += "  ★ 零干预成功"
+    return line
+
+
 def process_interaction_messages(
     interaction_message_queue: Queue,
     interaction_step_shift: int,
